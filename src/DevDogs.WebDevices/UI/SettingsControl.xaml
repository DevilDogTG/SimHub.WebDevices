<UserControl x:Class="DevDogs.WebDevices.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             x:Name="Root">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <!-- Paired buttons (Add/Remove, Export/Import, Save/Revert) share one size. -->
    <sys:Double x:Key="ButtonWidth">110</sys:Double>
    <sys:Double x:Key="ButtonHeight">30</sys:Double>
    <sys:Double x:Key="FieldHeight">28</sys:Double>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Height" Value="{StaticResource FieldHeight}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="Dashboard" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="IsEditable" Value="True" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="ItemsSource" Value="{Binding DataContext.Dashboards, ElementName=Root}" />
    </Style>
    <Style x:Key="Errors" TargetType="ItemsControl">
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate><TextBlock Text="{Binding}" Foreground="#FF6B6B" TextWrapping="Wrap" /></DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Warnings" TargetType="ItemsControl">
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate><TextBlock Text="{Binding}" Foreground="#FFC857" TextWrapping="Wrap" /></DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,8">

      <styles:SHSection Title="STATUS">
        <StackPanel>
          <TextBlock Text="{Binding ServerText}" />
          <TextBlock Text="{Binding StateText}" Margin="0,4,0,0" />
        </StackPanel>
      </styles:SHSection>

      <styles:SHTabControl Margin="0,8,0,0">

        <!-- Devices tab -->
        <styles:SHTabItem Header="Devices">
          <StackPanel Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Device list -->
              <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                  <styles:SHButtonPrimary Content="Add device" Command="{Binding AddDeviceCommand}"
                                          Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}" />
                  <styles:SHButtonSecondary Content="Remove" Command="{Binding RemoveDeviceCommand}" Margin="8,0,0,0"
                                            Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinHeight="200">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2,4">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="LimeGreen" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="11" Margin="17,2,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>

              <!-- Selected device -->
              <StackPanel Grid.Column="2" DataContext="{Binding SelectedDevice}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Name" />
                  <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}"
                           Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                  <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Open on device" />
                  <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" IsReadOnly="True" Text="{Binding Url, Mode=OneWay}" />
                  <styles:SHButtonSecondary Grid.Row="1" Grid.Column="2" Content="Copy" Margin="8,3,0,3" Click="CopyUrl_Click"
                                            MinWidth="80" Height="{StaticResource FieldHeight}" />

                  <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Now" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3" VerticalAlignment="Center"
                             Text="{Binding ShowingText}" />

                  <styles:SHToggleCheckbox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6"
                                           Content="Hide SimHub's dashboard controls (Fullscreen / Reload / Back panel shown on each load)" IsChecked="{Binding HideControls}" />
                </Grid>

                <styles:SHSubSection Title="When no game is running" Margin="0,12,0,0">
                  <ComboBox Style="{StaticResource Dashboard}" Text="{Binding SystemIdleDashboard, UpdateSourceTrigger=PropertyChanged}" />
                </styles:SHSubSection>

                <styles:SHSubSection Title="Any other game" Margin="0,8,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="In menus" />
                    <ComboBox Grid.Column="1" Style="{StaticResource Dashboard}" Text="{Binding DefaultGameIdle, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Driving" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Dashboard}" Text="{Binding DefaultDriving, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </styles:SHSubSection>

                <styles:SHSubSection Title="Per game" Margin="0,8,0,0">
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Game" Opacity="0.7" />
                      <TextBlock Grid.Column="1" Text="In menus (empty: as driving)" Opacity="0.7" Margin="4,0" />
                      <TextBlock Grid.Column="2" Text="Driving" Opacity="0.7" Margin="4,0" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Games}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="200" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding GameCode}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Dashboard}" Margin="4,0" Text="{Binding GameIdle, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="2" Style="{StaticResource Dashboard}" Margin="4,0" Text="{Binding Driving, UpdateSourceTrigger=PropertyChanged}" />
                            <styles:SHButtonSecondary Grid.Column="3" Content="Remove" Margin="4,0,0,0"
                                                      Command="{Binding DataContext.RemoveGameCommand, ElementName=Root}" CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <ComboBox Width="260" ItemsSource="{Binding DataContext.Games, ElementName=Root}"
                                SelectedItem="{Binding DataContext.SelectedGameToAdd, ElementName=Root}" />
                      <styles:SHButtonSecondary Content="Add game" Margin="8,0,0,0" Command="{Binding DataContext.AddGameCommand, ElementName=Root}" />
                      <styles:SHButtonSecondary Content="Add current game" Margin="8,0,0,0" Command="{Binding DataContext.AddCurrentGameCommand, ElementName=Root}" />
                    </StackPanel>
                  </StackPanel>
                </styles:SHSubSection>
              </StackPanel>
            </Grid>

            <!-- Devices save bar -->
            <StackPanel Margin="0,16,0,0">
              <ItemsControl Style="{StaticResource Errors}" ItemsSource="{Binding DeviceErrors}" />
              <ItemsControl Style="{StaticResource Warnings}" ItemsSource="{Binding Warnings}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <styles:SHButtonPrimary Content="Save" Command="{Binding SaveDevicesCommand}"
                                        Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}" />
                <styles:SHButtonSecondary Content="Revert" Margin="8,0,0,0" Command="{Binding RevertDevicesCommand}"
                                          Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}" />
                <TextBlock Text="Unsaved changes" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8"
                           Visibility="{Binding IsDevicesDirty, Converter={StaticResource Visible}}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </styles:SHTabItem>

        <!-- General tab -->
        <styles:SHTabItem Header="General">
          <StackPanel Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Device port" />
              <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="SimHub web port" />
              <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding SimHubWebPort, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Wait before 'no game' (ms)" />
              <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding SystemIdleDelayMs, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Wait before other switches (ms)" />
              <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding SwitchDelayMs, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                <styles:SHButtonSecondary Content="Export…" Click="Export_Click"
                                          Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}" />
                <styles:SHButtonSecondary Content="Import…" Margin="8,0,0,0" Click="Import_Click"
                                          Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}" />
              </StackPanel>
            </Grid>

            <!-- General save bar -->
            <StackPanel Margin="0,16,0,0">
              <ItemsControl Style="{StaticResource Errors}" ItemsSource="{Binding GeneralErrors}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <styles:SHButtonPrimary Content="Save" Command="{Binding SaveGeneralCommand}"
                                        Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}" />
                <styles:SHButtonSecondary Content="Revert" Margin="8,0,0,0" Command="{Binding RevertGeneralCommand}"
                                          Width="{StaticResource ButtonWidth}" Height="{StaticResource ButtonHeight}" />
                <TextBlock Text="Unsaved changes" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8"
                           Visibility="{Binding IsGeneralDirty, Converter={StaticResource Visible}}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </styles:SHTabItem>

      </styles:SHTabControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
